{
  "name": "soncollab-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run merge-i18n:client && ng serve client",
    "start:client": "npm run merge-i18n:client && ng serve client",
    "build": "npm run build:shared && npm run merge-i18n:client && ng build client",
    "build:prod": "npm run build:shared:prod && npm run merge-i18n:client && ng build client --configuration production",
    "build:staging": "npm run build:shared:prod && npm run merge-i18n:client && ng build client --configuration staging",
    "start:back-office": "npm run merge-i18n:back-office && ng serve back-office",
    "build:back-office": "npm run build:shared:prod && npm run merge-i18n:back-office && ng build back-office --configuration production",
    "build:back-office:dev": "npm run build:shared && npm run merge-i18n:back-office && ng build back-office",
    "build:shared": "ng build shared-lib",
    "build:shared:prod": "ng build shared-lib --configuration production",
    "merge-i18n:client": "node merge-i18n.js client",
    "merge-i18n:back-office": "node merge-i18n.js back-office",
    "merge-i18n:all": "npm run merge-i18n:client && npm run merge-i18n:back-office",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "ng e2e"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/localize": "^20.1.6",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@ng-bootstrap/ng-bootstrap": "19.0.1",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@popperjs/core": "^2.11.8",
    "@types/aos": "^3.0.7",
    "aos": "^2.3.4",
    "bootstrap": "5.3.7",
    "choices.js": "^11.0.2",
    "dlx": "^0.2.1",
    "global": "^4.4.0",
    "ng-recaptcha-2": "^16.0.1",
    "ngx-markdown": "^20.0.0",
    "or": "^0.2.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.22.0",
    "swiper": "^11.2.10",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.3.0",
    "@angular/build": "^20.0.5",
    "@angular/cli": "^20.0.5",
    "@angular/compiler-cli": "^20.0.0",
    "@eslint/js": "^9.35.0",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.3.0",
    "eslint": "^9.35.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.40.0"
  }
}
