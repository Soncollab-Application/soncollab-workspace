{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "client": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/client",
      "sourceRoot": "projects/client/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/client",
            "index": "projects/client/src/index.html",
            "browser": "projects/client/src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "projects/client/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/client/public"
              }
            ],
            "styles": [
              "projects/client/src/styles.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/@sweetalert2/theme-bootstrap-4/bootstrap-4.css",
              "node_modules/@ngneat/hot-toast/src/styles/styles.css",
              "projects/client/public/assets/icons/finder-icons.min.css",
              "projects/client/public/assets/vendor/simplebar/simplebar.min.css",
              "projects/client/public/assets/css/style.css",
              "projects/client/public/assets/vendor/nouislider/nouislider.min.css",
              "projects/client/public/assets/vendor/swiper/swiper-bundle.min.css",
              "projects/client/public/assets/css/theme.min.css"
            ],
            "scripts": [
              "node_modules/sweetalert2/dist/sweetalert2.min.js",
              "projects/client/public/assets/vendor/simplebar/simplebar.min.js",
              "projects/client/public/assets/vendor/nouislider/nouislider.min.js",
              "projects/client/public/assets/js/confetti.bundle.min.js",
              "projects/client/public/assets/vendor/swiper/swiper-bundle.min.js",
              "projects/client/public/assets/js/theme.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/client/src/environments/environment.ts",
                  "with": "projects/client/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "client:build:production"
            },
            "development": {
              "buildTarget": "client:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ],
            "tsConfig": "projects/client/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/client/public"
              }
            ],
            "styles": [
              "projects/client/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "b6c44f24-f674-426b-9dd9-1886856b9196"
  }
}
