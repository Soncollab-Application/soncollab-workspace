{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "client": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/client",
      "sourceRoot": "projects/client/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/client/src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "allowedCommonJsDependencies": [
              "lodash"
            ],
            "tsConfig": "projects/client/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/client/public"
              }
            ],
            "styles": [
              "projects/client/src/styles.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/aos/dist/aos.css",
              "projects/client/public/assets/icons/finder-icons.min.css",
              "projects/client/public/assets/icons/bootstrap-icons.min.css",
              "projects/client/public/assets/vendor/simplebar/simplebar.min.css",
              "projects/client/public/assets/css/style.css",
              "projects/client/public/assets/vendor/nouislider/nouislider.min.css",
              "projects/client/public/assets/vendor/swiper/swiper-bundle.min.css",
              "projects/client/public/assets/vendor/choices.js/choices.min.css",
              "projects/client/public/assets/css/features-global.css",
              "projects/client/public/assets/css/theme.min.css",
              "projects/client/public/assets/css/custom.css"
            ],
            "scripts": [
              "node_modules/aos/dist/aos.js",
              "projects/client/public/assets/vendor/simplebar/simplebar.min.js",
              "projects/client/public/assets/vendor/nouislider/nouislider.min.js",
              "projects/client/public/assets/js/confetti.bundle.min.js",
              "projects/client/public/assets/vendor/swiper/swiper-bundle.min.js",
              "projects/client/public/assets/vendor/choices.js/choices.min.js",
              "projects/client/public/assets/js/theme.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "50MB",
                  "maximumError": "100MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10MB",
                  "maximumError": "100MB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/client/src/environments/environment.ts",
                  "with": "projects/client/src/environments/environment.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/client/src/environments/environment.ts",
                  "with": "projects/client/src/environments/environment.development.ts"
                }
              ]
            },
            "staging": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false,
              "fileReplacements": [
                {
                  "replace": "projects/client/src/environments/environment.ts",
                  "with": "projects/client/src/environments/environment.staging.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "client:build:production"
            },
            "development": {
              "buildTarget": "client:build:development"
            },
            "staging": {
              "buildTarget": "client:build:staging"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ],
            "tsConfig": "projects/client/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/client/public"
              }
            ],
            "styles": [
              "projects/client/src/styles.css"
            ]
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "client:serve",
            "configFile": "projects/client/cypress.config.js"
          },
          "configurations": {
            "production": {
              "devServerTarget": "client:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false,
            "configFile": "projects/client/cypress.config.js"
          }
        },
        "ct": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "client:serve",
            "watch": true,
            "headless": false,
            "testingType": "component"
          },
          "configurations": {
            "development": {
              "devServerTarget": "client:serve:development"
            }
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "client:serve",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production": {
              "devServerTarget": "client:serve:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "b6c44f24-f674-426b-9dd9-1886856b9196",
    "schematicCollections": [
      "@cypress/schematic",
      "@schematics/angular"
    ]
  }
}